GOOGLE_DRIVE_EMAIL=your-address@example.com
AAM_PROJECT_FOLDER=DT2470 Project

# Optional override for the hierarchical CNN/HSMM artifacts and RWC caches.
# Set this to the local Google Drive Desktop path if the shared folder is not
# discovered automatically.
# AAM_DRIVE_DIR=/absolute/path/to/DT2470 Project

# Optional: folder containing the original RWC audio (for main.py --source rwc).
# RWC_AUDIO_DIR=/absolute/path/to/rwc/audio
